{
  "name": "Advanced Orders Platform - Part 1",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installMaven": true,
      "mavenVersion": "3.9.11",
      "installGradle": false
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true,
      "installDockerBuildx": true,
      "dockerDashComposeVersion": "v2"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "redhat.vscode-yaml"
      ]
    }
  },
  "forwardPorts": [
    8080,
    8081,
    8082
  ],
  "portsAttributes": {
    "8080": {
      "label": "Gateway",
      "onAutoForward": "notify"
    },
    "8081": {
      "label": "Inventory"
    },
    "8082": {
      "label": "Orders"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "remoteUser": "vscode"
}
